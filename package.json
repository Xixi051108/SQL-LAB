{
  "name": "sql-exam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "test:live": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.live.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "lucide-vue-next": "^0.468.0",
    "mysql2": "^3.15.3",
    "node-sql-parser": "^5.3.13",
    "sql-formatter": "^15.6.10",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.1"
  }
}
